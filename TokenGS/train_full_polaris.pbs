#!/bin/bash -l
#PBS -A ideas
#PBS -q preemptable
#PBS -l select=1:system=polaris
#PBS -l walltime=24:00:00
#PBS -l filesystems=home:eagle
#PBS -N querysplat_full
#PBS -j oe

set -euo pipefail

module swap PrgEnv-nvidia PrgEnv-gnu

source /eagle/ideas/lemeng_wang/miniconda3/etc/profile.d/conda.sh
conda activate tokengs

export CUDA_HOME=/opt/nvidia/hpc_sdk/Linux_x86_64/25.9/cuda/12.9
export PATH="$CUDA_HOME/bin:$PATH"
export CC=/opt/cray/pe/gcc-native/14/bin/gcc
export CXX=/opt/cray/pe/gcc-native/14/bin/g++
export CUDAHOSTCXX="$CXX"
export NVCC_CCBIN="$CXX"

export TORCH_CUDA_ARCH_LIST=8.0
export MAX_JOBS=4
export TORCH_HOME=/eagle/ideas/lemeng_wang/.cache/torch

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

cd ~/Documents/tokenNHT/self_implement_querysplat/TokenGS

DATA=/eagle/ideas/lemeng_wang/datasets/DL3DV-ALL-960P
OUT=/eagle/ideas/lemeng_wang/outputs/querysplat_full

mkdir -p "$OUT"

RESUME_ARGS=()
if [ -f "$OUT/latest.pt" ]; then
    echo "Resuming training from existing checkpoint"
    RESUME_ARGS=(--resume "$OUT/latest.pt")
fi

torchrun --standalone --nproc_per_node=4 \
    scripts/train_querysplat.py \
    --data-root "$DATA" \
    --total-steps 300000 \
    --warmup-steps 2000 \
    --learning-rate 1e-4 \
    --num-workers 2 \
    --checkpoint-every 500 \
    --image-every 500 \
    --log-every 10 \
    --precision bf16 \
    --workspace "$OUT" \
    "${RESUME_ARGS[@]}" \
    2>&1 | tee -a "$OUT/training.log"
